# AlarmClockXtreme Cloud
# SmartRotator-style GitHub persistence

GITHUB_REPO=anurag008w/smartrotator-data
GITHUB_DATA_SUBDIR=alarmclockxtreme
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_INTERVAL=180

# GitHub PAT with write access to the PRIVATE data repo
GH_TOKEN=

# Keep this in Render secrets; never commit it
JWT_SECRET=

# Optional AI provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini