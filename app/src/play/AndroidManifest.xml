<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Play flavor only: X1 Health Connect reads recent sleep sessions after
         explicit in-app opt-in and Health Connect permission grant. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Play flavor only: in-app update installs the downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Play flavor only: cloud server wake-up for background sync (FCM). -->
        <service
            android:name=".data.cloud.PlayFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
